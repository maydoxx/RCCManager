# copy to .env next to rccmanager.exe (real environment variables win over this file)

# game rcc: OpenJob/CloseJob/Execute only. ideally its own box or VM on the public game address
RCC_GAME_URL=http://127.0.0.1:64989/
RCC_GAME_SECRET=make a new one

# render rcc(s): BatchJob only, never reachable from the internet. comma separated = renders in parallel
RCC_RENDER_URL=http://127.0.0.1:64989/
RCC_RENDER_SECRET=make a new one

# gameserver.txt, lives next to RCCService.exe on the game box (the manager reads it, rcc gets it over soap)
GAMESERVER_SCRIPT=PLACE YOUR PATH

# how rcc reaches the site: lan address, never through cloudflare
# local dev (API on :3000); with Caddy on :80 use http://127.0.0.1
SITE_INTERNAL_URL=http://127.0.0.1:3000
# what the client connects to (MachineAddress in Join.ashx), ipv4 only
SITE_PUBLIC_ADDRESS=replaceme

# renders always go to R2; the manager has no local storage mode
# objects land at <R2_PREFIX>/<kind>/<id>.png in the bucket and the site links to <CDN_URL>/<kind>/<id>.png,
# so the bucket's custom domain + prefix must equal CDN_URL. Make an "R2 API token" with object read+write for the keys.
R2_ACCOUNT_ID=d15de159e17e3a5ca5b2ed0d8c852a7c
R2_BUCKET=nonerev
R2_PREFIX=
R2_ACCESS_KEY_ID=39e9b80bc3f41fc64bac64e5a11df880
R2_SECRET_ACCESS_KEY=9ccb12def464a61a4543ca7457f03f6ca21e3910d93425e308de9cc72f77adf2
CDN_URL=replaceme
# optional, default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (any S3 compatible endpoint works)
#R2_ENDPOINT=

# udp port range for game servers
PORT_MIN=3023
PORT_MAX=3072

# where the site reaches the manager, and the bearer token it sends
LISTEN=127.0.0.1:25500
PASSWORD=nonerev1337

# optional
#STATE_FILE=rccmanager-state.json
#IDLE_TIMEOUT=10m
#LEASE=24h
#REAP_EVERY=30s
#PLAYER_COUNT_TTL=10s
#READY_TIMEOUT=90s
